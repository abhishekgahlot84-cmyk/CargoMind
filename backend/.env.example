# CargoMind Backend Environment Configuration

# Database Configuration (PostgreSQL; defaults to SQLite if offline)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fleet_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Google Maps & Routes API Key (Server-Side highway distance/directions matrix)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Authentication Secret
JWT_SECRET=your_jwt_secret_key_here
