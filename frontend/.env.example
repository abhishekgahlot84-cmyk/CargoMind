# Backend API Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000

# Google Maps API Key
# Replace with your actual key from Google Cloud Console (Maps JavaScript API & Directions API enabled)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth 2.0 Web Client ID (from Google Cloud Console Credentials)
# Example: 1234567890-abcdefg.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
